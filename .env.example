# Claude API (Phase 1 diagnosis scripts — server/scripts only, never expose in the app)
ANTHROPIC_API_KEY=sk-ant-...

# Creatomate (Phase 2 result card rendering — server/scripts only)
CREATOMATE_API_KEY=...

# Cloudflare R2 (temporary photo storage — server only, deleted after analysis)
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=colorapp-photos

# Clerk (Native Third-Party Auth — no JWT template)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Comma-separated origins allowed in a token's `azp` claim. Without it, a valid
# Clerk token minted for another app on the same instance is accepted by our API
# routes. Leave unset for native-only development (no browser origin to assert);
# set it to the deployed origin before shipping a web surface.
CLERK_AUTHORIZED_PARTIES=https://colorapp--preview.expo.app

# Diagnosis result signing (server only — HMAC for the analyze→save envelope)
DIAGNOSIS_SIGNING_SECRET=64_hex_chars

# Supabase (new API key system: publishable = app/RLS, secret = server only)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Where the app/api/* routes are deployed. REQUIRED FOR ANY NON-DEV BUILD.
#
# In development lib/api.ts falls back to Constants.expoConfig.hostUri, so the
# dev server hosts the routes and this can be left unset. A release build has no
# dev server: the fallback is an empty string, apiUrl() then returns a bare
# "/api/analyze", and React Native's fetch rejects a relative URL — so upload,
# analyze, save and card all fail at once, and nothing in the build warns you.
# Set this to the deployed origin (EAS Hosting or equivalent) before building.
EXPO_PUBLIC_API_ORIGIN=https://your-deployment.example.com
